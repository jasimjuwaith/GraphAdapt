# LLM Provider Configuration
GROQ_API_KEY=replace_with_your_groq_api_key
LLM_MODEL_NAME=llama-3.3-70b-versatile

# Infrastructure Endpoints (Docker Compose Services)
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=admin
MEMGRAPH_PASSWORD=password123

REDIS_HOST=localhost
REDIS_PORT=6379

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graph_adapt_db
POSTGRES_USER=adapt_user
POSTGRES_PASSWORD=adapt_password

# System Operational Parameters
GATEKEEPER_THETA_THRESHOLD=15.0
GATEKEEPER_MAX_FP_24H=20
MAX_REGRESSION_RETRIES=3
LOG_LEVEL=INFO

# --- Batch 3 Gatekeeper Additions ---

# SIEM API Configuration (e.g., Wazuh, Splunk, Elastic)
SIEM_API_URL=https://siem.corp.internal:8080
SIEM_API_KEY=your_siem_api_key
SIEM_VERIFY_SSL=false

# Real-time telemetry and live SIEM
SIEM_MODE=mock
SPLUNK_URL=
SPLUNK_TOKEN=
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_ALERT_INDEX=logs-*
TELEMETRY_BATCH_SIZE=100
TELEMETRY_FLUSH_SECONDS=0.5
TELEMETRY_STREAM_MAXLEN=100000
GATEKEEPER_WINDOW_SECONDS=86400
GRAPH_RETENTION_HOURS=72
GRAPH_PRUNE_INTERVAL_SECONDS=3600

# Case Management / SOAR API Configuration (e.g., TheHive, ServiceNow)
# Used to retrieve human analyst dispositions (TP vs FP)
CASE_MANAGEMENT_API_URL=https://soar.corp.internal:9000
CASE_MANAGEMENT_API_KEY=your_soar_api_key
CASE_VERIFY_SSL=false